# Copie para .env (nunca commite o .env).
# Local: o Postgres do docker-compose.
DATABASE_URL=postgresql+psycopg://pitada:pitada@localhost:5432/pitada
# Chave do cookie de sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=troque-me
# Neon (producao): use a URL com ?sslmode=require. Para migracoes use a conexao direta (sem -pooler).
